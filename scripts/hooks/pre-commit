#!/bin/bash
# Localis pre-commit hook
#
# 1. SwiftLint the staged Swift files (fast — no build)
# 2. Incremental per-layer discovery: swift build + test for each touched
#    Packages/<X> (seconds each). App-target / docs-only changes skip this.
# 3. Frontmatter anti-rot check when any tech-context.md is staged.
#
# This is the fast inner-loop subset, scoped to the layers you actually touched.
# CI runs the full matrix (all packages + the app target).
#
# Enable with:  git config core.hooksPath scripts/hooks

set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"; cd "$REPO"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
[ -z "$STAGED" ] && exit 0

# ---- 1. SwiftLint staged Swift files ----------------------------------------

# A missing tool is "cannot judge", not "judged clean". Resolve it from the
# usual install locations before giving up — a hook that silently skips its
# only lint gate looks exactly like one that ran and passed, and which of the
# two you get depends on whose shell PATH happens to contain swiftlint.
SWIFTLINT_BIN="$(command -v swiftlint 2>/dev/null || true)"
for candidate in /opt/homebrew/bin/swiftlint /usr/local/bin/swiftlint; do
  [ -n "$SWIFTLINT_BIN" ] && break
  [ -x "$candidate" ] && SWIFTLINT_BIN="$candidate"
done
if [ -z "$SWIFTLINT_BIN" ]; then
  echo "[pre-commit] ❌ swiftlint not found (looked on PATH, /opt/homebrew/bin, /usr/local/bin)"
  echo "[pre-commit]    install it with: brew install swiftlint"
  echo "[pre-commit]    the lint gate cannot be skipped — CI runs it with --strict and will block the merge"
  exit 1
fi

if true; then
  STAGED_SWIFT=$(echo "$STAGED" | grep -E '\.swift$' || true)
  if [ -n "$STAGED_SWIFT" ]; then
    # The `excluded:` list is read from `.swiftlint.yml` rather than repeated
    # here. A second copy would be a second source of truth that drifts
    # silently: someone adds a path to the config, the hook keeps linting it,
    # and the two gates disagree again — which is the failure `--force-exclude`
    # was added to fix.
    EXCLUDED_GLOBS=()
    while IFS= read -r glob; do
      [ -n "$glob" ] && EXCLUDED_GLOBS+=("$glob")
    done < <(sed -n '/^excluded:/,/^[^ -]/p' .swiftlint.yml \
             | sed -n 's/^[[:space:]]*-[[:space:]]*//p')

    LINT_ARGS=()
    while IFS= read -r file; do
      [ -f "$file" ] || continue
      skip=""
      for glob in "${EXCLUDED_GLOBS[@]}"; do
        # shellcheck disable=SC2053  # the glob is meant to be a pattern
        case "$file" in $glob|$glob/*) skip=1; break ;; esac
      done
      [ -n "$skip" ] || LINT_ARGS+=("$file")
    done <<< "$STAGED_SWIFT"

    # **An empty set is "nothing to judge", not "judged and failed."**
    #
    # Without this branch, a commit touching only test files reached swiftlint
    # with a path list that `--force-exclude` then emptied. swiftlint treats
    # that as an error — `No lintable files found at paths: ...`, exit 1 — and
    # the hook read the exit code as a lint failure and aborted. Measured with
    # a positive control: one excluded test file gives rc=1, one non-excluded
    # source file gives rc=0.
    #
    # The consequence was worse than the false alarm. Every test-only commit
    # was blocked, and the only way past a hook is `--no-verify`, which
    # disables the per-layer build/test, the wiring self-test and the
    # frontmatter check as well — everything except the gate that misfired.
    #
    # Deliberately not implemented by matching the string `No lintable files`:
    # swiftlint is free to reword it, and the failure that rewording produces
    # is a hook that treats real violations as an empty set. Filtering first
    # means the empty case is decided here, from the config, before swiftlint
    # is asked anything.
    if [ ${#LINT_ARGS[@]} -eq 0 ]; then
      echo "[pre-commit] ℹ️  lint skipped: every staged .swift file is in .swiftlint.yml's excluded list"
    fi

    if [ ${#LINT_ARGS[@]} -gt 0 ]; then
      # `--force-exclude` is not optional here, and it is not a loosening.
      #
      # Passing explicit file paths to swiftlint *overrides* the `excluded:`
      # list in .swiftlint.yml — the paths win. CI runs `swiftlint lint
      # --strict` with no paths, so it honours the exclusions; this hook passes
      # the staged files, so without this flag it lints files the project has
      # decided are out of scope (`Packages/*/Tests`, `LocalisTests`).
      #
      # The two gates then disagree, in the direction that wastes the most
      # time: the hook blocks a commit over pre-existing fixture code that CI
      # is perfectly happy with, in a file the author only touched incidentally.
      # Hit for real on a three-line change to `SwiftDataSessionRepositoryTests`
      # (#28), where what got flagged was two `UUID(uuidString:)!` constants
      # that have been sitting on `main` untouched.
      #
      # This does not weaken the gate: a force unwrap under `Localis/` or
      # `Packages/*/Sources` is still caught, verified with a planted one. It
      # only stops the hook from judging files by a rule CI does not apply.
      #
      # Why it matters more than the keystrokes it saves: a local gate stricter
      # than the remote one is what gets `--no-verify` reached for, and that
      # switch disables *every* check below — the layer build, the wiring
      # self-test, the frontmatter check — not the one that misfired. The hook
      # is only worth obeying while its answer matches CI's.
      if ! "$SWIFTLINT_BIN" lint --quiet --strict --force-exclude -- "${LINT_ARGS[@]}"; then
        echo "❌ SwiftLint errors in staged files. Commit aborted."
        exit 1
      fi
    fi
  fi
fi

# ---- 2. Frontmatter anti-rot -----------------------------------------------
#
# Fires on three staged shapes, not just the obvious one:
#   - a tech-context.md            — the file whose contents can rot
#   - a Packages/<X>/Package.swift — how a *new* layer arrives, and the case
#     the old filter missed entirely: a package added without a tech-context.md
#     staged nothing this pattern matched, so the one commit that introduces an
#     unchecked layer was also the one commit that skipped the check
#   - the checker itself           — an edit to the check is when its self-test
#     matters most, and a path filter would otherwise skip it
#
# The self-test is blocking and runs first, for the same reason it does for the
# wiring check: this script's whole job is to turn a missing tech-context.md
# into an error, and a coverage check that has lost the ability to fail would
# restore that silence while still printing ✅.

if echo "$STAGED" | grep -qE '(tech-context\.md$|^Packages/[^/]+/Package\.swift$|^scripts/check-frontmatter\.sh$)'; then
  if [ -x scripts/check-frontmatter.sh ]; then
    if ! bash scripts/check-frontmatter.sh --self-test >/dev/null; then
      echo "❌ scripts/check-frontmatter.sh can no longer detect an unchecked layer."
      echo "   A green frontmatter check that cannot fail is worse than none. Commit aborted."
      exit 1
    fi
    if ! bash scripts/check-frontmatter.sh; then
      echo "❌ tech-context.md frontmatter is out of sync. Commit aborted."
      exit 1
    fi
  fi
fi

# ---- 2b. Wiring: the app target must really use what project.yml declares ---
#
# Runs when the app target or its build config is staged — a commit touching
# only Packages/ cannot change that answer — and also when the check itself is
# staged, because an edit to the checker is exactly when its self-test matters
# most and the path filter would otherwise skip it.
#
# Advisory, not blocking, and deliberately so: the check is RED today (#16),
# so a blocking version would refuse every commit including the ones that fix
# it. The self-test *is* blocking, because a check that can no longer fail is
# the failure this whole exercise exists to prevent.

if echo "$STAGED" | grep -qE '^(Localis/|project\.yml$|scripts/check-wiring\.sh$)'; then
  if [ -x scripts/check-wiring.sh ]; then
    if ! bash scripts/check-wiring.sh --self-test >/dev/null; then
      echo "❌ scripts/check-wiring.sh can no longer detect an unwired package."
      echo "   A green wiring check that cannot fail is worse than none. Commit aborted."
      exit 1
    fi
    # The wiring check must be able to fail the commit. `|| true` here would be
    # the same defect this gate exists to catch: a red light nobody reacts to is
    # indistinguishable from a green one.
    #
    # WAIVER — expires when US4 (the `/` skill picker) reaches the app layer.
    #   SkillsKit is declared in project.yml and deliberately kept (Amendment B
    #   keeps the package; spec.md:508 still lists it under ChatService's
    #   depends_on), but the app has not wired the picker UI yet. That is a real
    #   feature gap, not a config error — deleting the dependency would turn the
    #   light green while hiding the gap.
    # Whoever wires US4: delete this waiver, do not extend it. Any package NOT
    # named here fails the commit.
    #
    # Matched against `--porcelain` (`VERDICT<TAB>PACKAGE`), not against the
    # prose. The prose form worked, but only for as long as nobody reworded it:
    # its filter keys on a literal `     - ` prefix and an em dash, so changing
    # `- X — declared…` to `* X: declared…` makes the filter match nothing —
    # and "matched nothing" is spelled the same way here as "no problems",
    # i.e. the commit is allowed through. Verified: with the prose reworded, a
    # brand-new unwired package sails past; with --porcelain it is still caught.
    # The verdict vocabulary is fixed, so it has no such failure mode.
    #
    # The waiver is keyed on verdict+package, not package alone: declared-but-
    # never-imported and imported-but-unused are different bugs, and a waiver
    # for one must not silently cover the other.
    WIRING_WAIVER="$(printf 'NOT-IMPORTED\tSkillsKit')"
    WIRING_PROBLEMS="$(bash scripts/check-wiring.sh --porcelain 2>/dev/null || true)"
    if [ -n "$WIRING_PROBLEMS" ]; then
      UNWAIVED="$(comm -23 \
        <(printf '%s\n' "$WIRING_PROBLEMS" | grep -v '^$' | sort) \
        <(printf '%s\n' "$WIRING_WAIVER" | grep -v '^$' | sort))"
      if [ -n "$UNWAIVED" ]; then
        bash scripts/check-wiring.sh || true   # the readable version, for the human
        echo "[pre-commit] ❌ wiring check failed for packages outside the waiver:"
        printf '%s\n' "$UNWAIVED" | sed 's/^/     /'
        exit 1
      fi
      echo "[pre-commit] ⚠️  wiring: only the documented waiver is unwired — allowed for now"
    fi

    # A waiver that no longer matches anything is its own defect: the gap it
    # excused is fixed, and it now sits here ready to forgive the next problem
    # that happens to have the same shape.
    while IFS= read -r waived; do
      [ -z "$waived" ] && continue
      printf '%s\n' "$WIRING_PROBLEMS" | grep -qF -- "$waived" || {
        echo "[pre-commit] ⚠️  waiver no longer applies: $waived"
        echo "[pre-commit]    that gap is fixed — delete the waiver, don't leave it armed"
      }
    done <<< "$WIRING_WAIVER"
  fi
fi

# ---- 2c. Credentials must not reach a log, a file, an argv or a step output --
#
# Triggered by any shell or workflow change, because that is where the criterion
# applies: a credential's *destination*, not its shape. The checker itself is in
# the pattern (`\.sh$`), so editing it runs its own self-test.
#
# This one blocks with no waiver. The wiring check above has one because it
# reports a tracked feature gap that a commit cannot reasonably close; a
# credential arriving in a run log has no such excuse — and an exposure that
# genuinely has no better form is already expressible in place, as
# `# credential-exposure: <sink> — <reason>`, which is a decision on the record
# rather than a list kept somewhere else.
if echo "$STAGED" | grep -qE '(\.sh$|^scripts/hooks/|^\.github/workflows/)'; then
  if [ -x scripts/check-script-credentials.sh ]; then
    if ! bash scripts/check-script-credentials.sh --self-test >/dev/null; then
      echo "❌ scripts/check-script-credentials.sh can no longer detect a leaked credential."
      echo "   A credential check that cannot prove it goes red reports the same"
      echo "   zero as a clean repo. Commit aborted."
      exit 1
    fi
    if ! bash scripts/check-script-credentials.sh; then
      echo "[pre-commit] ❌ a declared credential's value leaves the variable (see above)."
      exit 1
    fi
  fi
fi

# ---- 3. Incremental per-layer swift build + test ----------------------------
# Map staged paths → touched Packages/<X> layers, then build+test each.
# Fast (SPM, no simulator). Untouched layers are never built.

command -v swift >/dev/null 2>&1 || exit 0

TOUCHED_LAYERS=$(echo "$STAGED" \
  | grep -E '^Packages/[^/]+/' \
  | sed -E 's|^Packages/([^/]+)/.*|\1|' \
  | sort -u || true)

[ -z "$TOUCHED_LAYERS" ] && exit 0

# Guard: many touched layers × per-layer build+test breaks the "fast" promise.
# Above the cap, build only — CI still runs the full test matrix.
LAYER_COUNT=$(echo "$TOUCHED_LAYERS" | sed '/^$/d' | wc -l | tr -d ' ')
MAX_TEST_LAYERS=3
RUN_TESTS=true
if [ "$LAYER_COUNT" -gt "$MAX_TEST_LAYERS" ]; then
  RUN_TESTS=false
  echo "⚠️  ${LAYER_COUNT} layers touched (>${MAX_TEST_LAYERS}): pre-commit builds only; CI runs the tests."
fi

FAIL=0
while IFS= read -r pkg; do
  [ -z "$pkg" ] && continue
  [ -d "Packages/$pkg" ] || continue
  LOG=$(mktemp)

  echo "🔨 swift build [$pkg]"
  if ! swift build --package-path "Packages/$pkg" > "$LOG" 2>&1; then
    echo "❌ swift build failed [$pkg]"; tail -20 "$LOG"; FAIL=1; rm -f "$LOG"; continue
  fi

  if [ "$RUN_TESTS" = true ]; then
    echo "🧪 swift test  [$pkg]"
    if ! swift test --package-path "Packages/$pkg" > "$LOG" 2>&1; then
      echo "❌ swift test failed [$pkg]"; tail -30 "$LOG"; FAIL=1
    fi
  fi
  rm -f "$LOG"
done <<< "$TOUCHED_LAYERS"

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "❌ Layer build/test failed. Commit aborted (don't --no-verify; CI blocks it anyway)."
  exit 1
fi

echo "✅ pre-commit: touched layer(s) build/test passed."
