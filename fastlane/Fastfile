# Localis TestFlight release lane.
#
# Invoked by .github/workflows/testflight.yml on a self-hosted mac runner.
# Auth is entirely via an App Store Connect API key (.p8) — no Apple ID, no 2FA.
#
# Environment variables (injected by the workflow from GitHub Secrets):
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8_BASE64
#
# Signing: manual + an App Store distribution profile that fastlane fetches for
# the paid team. Deliberately NOT automatic — a shared runner keychain holds
# certificates for several Apple accounts, and automatic signing resolves a
# Development certificate per target during archive. The paid team 4Z8GG667QD
# has Distribution but no Development certificate, so automatic falls back to
# some other account's Development cert and archive dies with
# errSecInternalComponent. Fetching the profile explicitly removes the guess.
#
# NOTE (first run): the App Store Connect app record for `com.leepepe.localis`
# must exist before the first upload. A new app cannot reuse another app's
# TestFlight record — create it once in App Store Connect (or via
# `fastlane produce`), then this lane is self-service from then on.

require "base64"

default_platform(:ios)

APP_IDENTIFIER = "com.leepepe.localis".freeze
SCHEME = "Localis".freeze
XCODEPROJ = "Localis.xcodeproj".freeze
TEAM_ID = "4Z8GG667QD".freeze
MARKETING_VERSION = "1.0".freeze

platform :ios do
  desc "Build and upload a build to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # The .xcodeproj is generated, never committed — regenerate before building.
    sh("cd .. && xcodegen generate")

    # The build number must be GLOBALLY monotonic (it does not reset when the
    # marketing version bumps). Passing `version:` here would scope the query to
    # the current marketing version, so a bump to 1.1 would restart at build 1 —
    # and ASC compares builds by the global build number, so 1.1(1) would read
    # as older than 1.0(4). Omitting `version:` queries the max across all
    # versions, which is what we want.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    next_build = latest.to_i + 1
    UI.message("TestFlight latest build (all versions) = #{latest}; this build = #{next_build}")

    # Fetch the App Store distribution profile for the paid team, creating it in
    # the Developer Portal when needed.
    #
    # force: true — always regenerate. After an App ID gains a capability, an
    # older profile is a snapshot from before that change and lacks the new
    # entitlements; fastlane's default (force: false) would reuse the stale one
    # and archive fails with "profile doesn't include the … capability".
    app_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      force: true,
      skip_install: false
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      # Signing comes from project.yml's Release config (Manual +
      # PROVISIONING_PROFILE_SPECIFIER, with the profile installed above).
      # Only the build number and team are injected here.
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} DEVELOPMENT_TEAM=#{TEAM_ID}",
      export_options: {
        manageAppVersionAndBuildNumber: false,
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name",
                                      app_profile)
        }
      },
      output_directory: ENV.fetch("RUNNER_TEMP", "/tmp"),
      clean: true
    )

    # Upload and wait for ASC to finish processing (a prerequisite for group
    # distribution).
    #
    # NOTE: `upload_to_testflight`'s `groups:` parameter only takes effect with
    # `distribute_external: true`. We distribute to an INTERNAL group, so
    # `groups:` would be silently ignored — the build uploads and processes but
    # never reaches the testers, with nothing in the log to say so. ASC requires
    # manual distribution for internal groups on Xcode/API uploads and offers no
    # auto-distribute switch, so the explicit spaceship call below does it.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false
    )

    # Explicitly add the uploaded build to the internal group(s) — default
    # "Internal", override with TESTFLIGHT_GROUPS (comma-separated).
    # Tolerant by design: the binary is already uploaded, so a distribution
    # failure should not fail the whole lane unless TESTFLIGHT_STRICT_UPLOAD=1.
    tf_group_names = ENV.fetch("TESTFLIGHT_GROUPS", "Internal")
                        .split(",").map(&:strip).reject(&:empty?)
    begin
      require "spaceship"
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
      )
      asc_app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
      build = Spaceship::ConnectAPI::Build.all(
        app_id: asc_app.id,
        version: MARKETING_VERSION,
        build_number: next_build.to_s
      ).first
      UI.user_error!("Uploaded build #{MARKETING_VERSION}(#{next_build}) not found in ASC for distribution") if build.nil?

      all_groups = asc_app.get_beta_groups
      tf_group_names.each do |gname|
        grp = all_groups.find { |g| g.name == gname }
        if grp.nil?
          UI.important("Beta group '#{gname}' not found in ASC — skipping (check the exact name, case-sensitive).")
          next
        end
        build.add_beta_groups(beta_groups: [grp])
        UI.success("Distributed build #{MARKETING_VERSION}(#{next_build}) to group '#{gname}'.")
      end
    rescue => e
      UI.error("Internal-group distribution failed: #{e.message}")
      UI.important("Binary upload succeeded; the build is in TestFlight but not distributed to the group — add it manually or re-run.")
      raise e if ENV["TESTFLIGHT_STRICT_UPLOAD"] == "1"
    end
  end
end
