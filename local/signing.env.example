# Signing identity — copy to `local/signing.env` and fill in your own values.
#
#   cp local/signing.env.example local/signing.env
#   $EDITOR local/signing.env
#   source local/signing.env && xcodegen generate
#
# `local/` is gitignored, so the real values never reach the repository.
# CI supplies the same variables from repository secrets instead.

# Your Apple Developer team id (Membership page in the developer portal).
export LOCALIS_TEAM_ID=XXXXXXXXXX

# The bundle identifier you own. Widgets/extensions derive from it by suffix.
export LOCALIS_APP_IDENTIFIER=com.example.localis
